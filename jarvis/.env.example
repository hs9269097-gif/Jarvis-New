# JARVIS server
PORT=8787
SESSION_SECRET=replace-with-a-long-random-value
AUTH_REQUIRED=false

# Anthropic Claude (recommended configuration)
AI_PROVIDER=anthropic
AI_MODEL=claude-opus-5
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional OpenAI-compatible provider
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1

# Optional Google Gemini provider
GEMINI_API_KEY=

# Optional local OpenAI-compatible provider (Ollama, LM Studio, etc.)
LOCAL_AI_BASE_URL=
LOCAL_AI_MODEL=llama3

# Optional web search: brave | tavily | serpapi
SEARCH_PROVIDER=
SEARCH_API_KEY=
