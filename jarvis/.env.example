# ─────────────────────────────────────────────────────────────────────────────
# JARVIS — environment configuration
# Copy this file to `.env` in the same folder and fill in your real values.
#   cp .env.example .env
# `.env` is git-ignored. NEVER commit real API keys.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────────────────
PORT=8787
HOST=0.0.0.0
NODE_ENV=development

# Signs session cookies. Use a long random string in production:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Require login before any /api route (default false = open guest session).
AUTH_REQUIRED=false

# Where the embedded JSON store + uploaded files live.
# Set to a mounted volume in production (e.g. /data on a Render Disk).
# DATA_DIR=/data

# ── AI provider ──────────────────────────────────────────────────────────────
# Which provider to use: demo | openai | anthropic | gemini | local
# "demo" = simulated replies, no key needed.
AI_PROVIDER=anthropic

# Anthropic (Claude) — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-...
ANTHROPIC_MODEL=claude-sonnet-4-5

# OpenAI / any OpenAI-compatible endpoint (Azure, Groq, OpenRouter, Together…)
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash-latest

# Local model server (Ollama, LM Studio, llama.cpp…)
LOCAL_AI_BASE_URL=
LOCAL_AI_MODEL=llama3

# Generation defaults
AI_MAX_TOKENS=2048
AI_TEMPERATURE=0.7

# ── Web search (optional) ────────────────────────────────────────────────────
# Without a key the web_search tool returns clearly-labelled DEMO results.
SEARCH_PROVIDER=
SEARCH_API_KEY=
